# ====================================================================
# Environment Configuration Template
# ====================================================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ====================================================================

# Active environment (dev, uat, prod)
ENV=dev

# ──────────────────────────────────────────────────────────────────────
# Application URLs
# ──────────────────────────────────────────────────────────────────────

APP_BASE_URL=https://www.saucedemo.com

# ──────────────────────────────────────────────────────────────────────
# Sauce Demo Test Users (public demo site — safe to use)
# ──────────────────────────────────────────────────────────────────────

APP_STANDARD_USER=standard_user
APP_STANDARD_PASS=secret_sauce

APP_LOCKED_USER=locked_out_user
APP_LOCKED_PASS=secret_sauce

APP_PROBLEM_USER=problem_user
APP_PROBLEM_PASS=secret_sauce

APP_PERF_USER=performance_glitch_user
APP_PERF_PASS=secret_sauce

# ──────────────────────────────────────────────────────────────────────
# API Testing (ReqRes.in public API)
# ──────────────────────────────────────────────────────────────────────

API_BASE_URL=https://reqres.in/api
API_KEY=reqres-free-v1
